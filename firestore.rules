rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /familias/{codigo} {
      function logado() { return request.auth != null; }
      function souResponsavel() { return logado() && request.auth.uid in resource.data.pais; }
      function souAparelhoDeCrianca() { return logado() && request.auth.uid in resource.data.aparelhos; }
      function mudou() { return request.resource.data.diff(resource.data).affectedKeys(); }

      // ler: só quem é da família
      allow read: if souResponsavel() || souAparelhoDeCrianca();

      // criar: o responsável cria a família no próprio nome
      allow create: if logado()
        && request.resource.data.dono == request.auth.uid
        && request.resource.data.pais == [request.auth.uid]
        && request.resource.data.aparelhos == [];

      allow update: if
        // responsável muda tudo, menos quem é dono e quem são os responsáveis
        (souResponsavel()
          && request.resource.data.dono == resource.data.dono
          && request.resource.data.pais == resource.data.pais)
        // aparelho da criança só marca missões
        || (souAparelhoDeCrianca() && mudou().hasOnly(['feitos']))
        // quem tem o código entra como aparelho de criança (um por vez)
        || (logado() && mudou().hasOnly(['aparelhos'])
          && request.resource.data.aparelhos.size() == resource.data.aparelhos.size() + 1
          && request.resource.data.aparelhos.hasAll(resource.data.aparelhos)
          && request.auth.uid in request.resource.data.aparelhos);

      allow delete: if logado() && request.auth.uid == resource.data.dono;
    }
  }
}
